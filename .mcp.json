{
  "mcpServers": {
    "primeng": {
      "command": "npx",
      "args": ["-y", "@primeng/mcp"]
    },
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=mwflkwazlhvrtckbbkpi"
    },
    "console-ninja": {
      "command": "cmd.exe",
      "args": ["/c", "node", "%USERPROFILE%/.console-ninja/mcp/"]
    },
    "playwright": {
      "url": "http://localhost:8931/mcp"
    }
  }
}
